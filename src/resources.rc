#include <winver.h>

1 ICON "icon.ico"

// Keep in sync with the VERSION file in the repository root.
#ifndef RB_VERSION_COMMA
#define RB_VERSION_COMMA 5,2,0,0
#endif
#ifndef RB_VERSION_STR
#define RB_VERSION_STR "5.2.0"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION RB_VERSION_COMMA
 PRODUCTVERSION RB_VERSION_COMMA
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Rclone Explorer"
      VALUE "FileDescription", "Rclone Explorer"
      VALUE "FileVersion", RB_VERSION_STR
      VALUE "InternalName", "RcloneExplorer"
      VALUE "LegalCopyright", "MIT License"
      VALUE "OriginalFilename", "Rclone Explorer.exe"
      VALUE "ProductName", "Rclone Explorer"
      VALUE "ProductVersion", RB_VERSION_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
